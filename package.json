{
  "name": "nova",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Nova — desktop AI call copilot (npm-workspaces monorepo)",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/desktop"
  ],
  "scripts": {
    "typecheck": "tsc -b && npm run typecheck:tests",
    "typecheck:tests": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p apps/server/tsconfig.json --noEmit && tsc -p apps/desktop/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:start": "supabase start",
    "db:migrate": "supabase migration up",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^7.3.6",
    "vitest": "^2.1.8"
  }
}
