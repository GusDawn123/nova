# Nova environment — variable names only, never real values (RULES §11).
# Copy to `.env` (server runtime) or `.env.test` (integration tests); both are
# gitignored. All Supabase vars are OPTIONAL — the server boots and serves
# /health without them; only the db adapter / integration test require them.

# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Supabase (local stack). Get live values with:  supabase status -o env
# API_URL -> SUPABASE_URL,  SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY,
# ANON_KEY -> SUPABASE_ANON_KEY.
# The local service-role key is a public default but is still treated as a secret.
# SUPABASE_ANON_KEY is the publishable per-user key the RLS isolation tests use to
# build authenticated clients for two real users; unused by the server itself.
# The auth preHandler verifies access tokens against Supabase's published ES256
# signing keys (JWKS), fetched from SUPABASE_URL — so no separate JWT secret is
# needed by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# LLM providers (Phase 2). All OPTIONAL — the server boots without them, and the llm
# module builds only the providers whose key is set (in failover order). Server-side
# keys only; never ship these in the mobile app. Get keys from each vendor's console.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# STT vendors (Phase 3.5). Both OPTIONAL — the server boots without them; the STT
# engine just has no vendors and a live session gets a typed error instead of a
# transcript. ASSEMBLYAI_API_KEY = primary vendor (AssemblyAI Universal-Streaming),
# DEEPGRAM_API_KEY = fallback (Deepgram nova-3). Fixed primary-first failover order.
# Company-held keys, treated as secrets: never commit real values, never ship to
# the mobile app. When present, the key-gated STT accuracy tests
# (adapters/live.accuracy.test.ts) run against the real vendors; absent, they skip.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# RAG (Phase 4). Both OPTIONAL — the server boots without them; ingest + live
# retrieval degrade to a typed RAG_NOT_CONFIGURED instead of crashing.
# VOYAGE_API_KEY = Voyage AI embeddings + rerank (voyage-4 docs / voyage-4-lite
# queries @ 1024 dims, rerank-2.5-lite). Company-held secret; never commit, never
# ship to the mobile app. When present, the key-gated Voyage live smoke
# (modules/rag/adapters/voyage.live.smoke.test.ts) runs; absent, it skips.
VOYAGE_API_KEY=
# SUPABASE_DB_URL = direct Postgres connection for the pgvector adapter (the hot
# retrieval path bypasses PostgREST — adr-0005 §4) AND the Phase 5 notes jobs queue.
# Local stack default (from
# `supabase status` -> DB_URL): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Carries the DB password — treated as a secret, never logged. When present, the
# DB-gated pgvector integration test runs; absent, it skips.
SUPABASE_DB_URL=

# Post-call notes worker (Phase 5). OPTIONAL, off by default: the durable-queue
# machinery (worker poll loop + lease reaper + eager-enqueue seam) runs only when
# this is exactly "true" AND SUPABASE_DB_URL is set AND at least one LLM provider
# key is present — explicit opt-in, never on under test or on keyless boots. The
# notes REST surface (GET/regenerate/follow-up) is independent of this switch (it
# needs only the Supabase + DB env).
NOTES_WORKER_ENABLED=

# Dev-only LLM answer ledger (2026-08-19). OPTIONAL, hard-off by default. When
# set, every live copilot generation appends one JSONL line (trigger, FULL
# answer text, outcome, timing, cache stats) for prompt-register diagnosis.
# "1"/"true" writes apps/server/.dev/llm-transcript.jsonl (gitignored); any
# other value is used as the file path. This logs RAW CONVERSATION CONTENT —
# a deliberate, opt-in local-dev exception to RULES §6. NEVER set in production.
LLM_DEBUG_TRANSCRIPT=

# RevenueCat webhook (Phase 6). OPTIONAL — when unset the POST /webhooks/revenuecat
# route is not registered. When set, RevenueCat must send
# `Authorization: Bearer <token>` (configure the same value in the RevenueCat
# dashboard's webhook settings). Requires SUPABASE_DB_URL (the plan writer).
# Live RevenueCat account + product catalog are Phase 8+ items.
REVENUECAT_WEBHOOK_TOKEN=

# Desktop (Electron). All NOVA_ vars live in apps/desktop/.env (gitignored) and
# are read by the MAIN process — never the renderer. electron-vite inlines them
# at build time via `envPrefix: "NOVA_"`, which is declared on the `main` config
# alone (apps/desktop/electron.vite.config.ts), so a NOVA_ value can never be
# substituted into the renderer bundle. The prefix says what they are rather
# than which bundle they land in, which is why it is not EXPO_PUBLIC_/VITE_.
#
# Why main and not the renderer: the server's CORS allowlist admits
# localhost/127.0.0.1 origins, a packaged renderer loads from file:// and sends
# `Origin: null`, and the main process sends no Origin at all — the same
# position the native mobile app is in. Auth, session storage and all HTTP
# therefore live in main; the renderer talks to it over IPC.
#
# Base URL the desktop app uses to reach the Nova server. Falls back to the
# local dev server (http://127.0.0.1:3000) when unset or malformed, so
# `npm run dev --workspace apps/desktop` works out of the box.
NOVA_API_URL=
# Supabase project the desktop app authenticates against (email/password).
# PUBLIC url + anon (publishable) key, exactly as the mobile app ships them —
# never a service-role key. Local values: `supabase status` (API_URL, ANON_KEY).
# When unset/invalid the app shows a typed "not configured" screen instead of a
# sign-in form that could never succeed.
NOVA_SUPABASE_URL=
NOVA_SUPABASE_ANON_KEY=

# Mobile (Expo). All EXPO_PUBLIC_ vars are inlined into the bundle at build time
# and read/zod-parsed by the app; live in apps/mobile/.env (gitignored) for local
# runs, never here with real values.
#
# Base URL the app uses to reach the Nova server. Falls back to the local dev
# server (http://127.0.0.1:3000) when unset, so `expo start` works out of the box.
EXPO_PUBLIC_API_URL=
# Supabase project the app authenticates against (email/password). These are the
# PUBLIC url + anon (publishable) key — safe to ship in a client bundle, never a
# service-role key. Local values: `supabase status` (API_URL, ANON_KEY). When
# unset/invalid the app shows a typed "auth unavailable" state instead of crashing.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
