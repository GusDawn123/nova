# Nova environment — variable names only, never real values (RULES §11).
# Copy to `.env` (server runtime) or `.env.test` (integration tests); both are
# gitignored. All Supabase vars are OPTIONAL — the server boots and serves
# /health without them; only the db adapter / integration test require them.

# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Supabase (local stack). Get live values with:  supabase status -o env
# API_URL -> SUPABASE_URL,  SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY,
# ANON_KEY -> SUPABASE_ANON_KEY.
# The local service-role key is a public default but is still treated as a secret.
# SUPABASE_ANON_KEY is the publishable per-user key the RLS isolation tests use to
# build authenticated clients for two real users; unused by the server itself.
# The auth preHandler verifies access tokens against Supabase's published ES256
# signing keys (JWKS), fetched from SUPABASE_URL — so no separate JWT secret is
# needed by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Mobile (Expo). Base URL the app uses to reach the Nova server. Inlined into
# the bundle at build time (EXPO_PUBLIC_ prefix); falls back to the local dev
# server (http://127.0.0.1:3000) when unset, so `expo start` works out of the box.
EXPO_PUBLIC_API_URL=
