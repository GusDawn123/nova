# Nova environment — variable names only, never real values (RULES §11).
# Copy to `.env` (server runtime) or `.env.test` (integration tests); both are
# gitignored. All Supabase vars are OPTIONAL — the server boots and serves
# /health without them; only the db adapter / integration test require them.

# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1

# Supabase (local stack). Get live values with:  supabase status -o env
# API_URL -> SUPABASE_URL,  SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY,
# ANON_KEY -> SUPABASE_ANON_KEY.
# The local service-role key is a public default but is still treated as a secret.
# SUPABASE_ANON_KEY is the publishable per-user key the RLS isolation tests use to
# build authenticated clients for two real users; unused by the server itself.
# The auth preHandler verifies access tokens against Supabase's published ES256
# signing keys (JWKS), fetched from SUPABASE_URL — so no separate JWT secret is
# needed by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# LLM providers (Phase 2). All OPTIONAL — the server boots without them, and the llm
# module builds only the providers whose key is set (in failover order). Server-side
# keys only; never ship these in the mobile app. Get keys from each vendor's console.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# STT vendors (Phase 3.5). Both OPTIONAL — the server boots without them; the STT
# engine just has no vendors and a live session gets a typed error instead of a
# transcript. ASSEMBLYAI_API_KEY = primary vendor (AssemblyAI Universal-Streaming),
# DEEPGRAM_API_KEY = fallback (Deepgram nova-3). Fixed primary-first failover order.
# Company-held keys, treated as secrets: never commit real values, never ship to
# the mobile app. When present, the key-gated STT accuracy tests
# (adapters/live.accuracy.test.ts) run against the real vendors; absent, they skip.
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# RAG (Phase 4). Both OPTIONAL — the server boots without them; ingest + live
# retrieval degrade to a typed RAG_NOT_CONFIGURED instead of crashing.
# VOYAGE_API_KEY = Voyage AI embeddings + rerank (voyage-4 docs / voyage-4-lite
# queries @ 1024 dims, rerank-2.5-lite). Company-held secret; never commit, never
# ship to the mobile app. When present, the key-gated Voyage live smoke
# (modules/rag/adapters/voyage.live.smoke.test.ts) runs; absent, it skips.
VOYAGE_API_KEY=
# SUPABASE_DB_URL = direct Postgres connection for the pgvector adapter (the hot
# retrieval path bypasses PostgREST — adr-0005 §4). Local stack default (from
# `supabase status` -> DB_URL): postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Carries the DB password — treated as a secret, never logged. When present, the
# DB-gated pgvector integration test runs; absent, it skips.
SUPABASE_DB_URL=

# Mobile (Expo). All EXPO_PUBLIC_ vars are inlined into the bundle at build time
# and read/zod-parsed by the app; live in apps/mobile/.env (gitignored) for local
# runs, never here with real values.
#
# Base URL the app uses to reach the Nova server. Falls back to the local dev
# server (http://127.0.0.1:3000) when unset, so `expo start` works out of the box.
EXPO_PUBLIC_API_URL=
# Supabase project the app authenticates against (email/password). These are the
# PUBLIC url + anon (publishable) key — safe to ship in a client bundle, never a
# service-role key. Local values: `supabase status` (API_URL, ANON_KEY). When
# unset/invalid the app shows a typed "auth unavailable" state instead of crashing.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
