# deps / builds
node_modules/
dist/
build/
.expo/
*.tsbuildinfo

# electron-vite bundles main/preload/renderer here (apps/desktop/dist is already
# covered by the dist/ rule above — that one is tsc's typecheck emit)
apps/desktop/out/

# Expo / React Native (apps/mobile — merged from the template's .gitignore)
# expo-env.d.ts is CLI-generated and ignored; apps/mobile/expo-types.d.ts is the
# committed equivalent that keeps `tsc --noEmit` deterministic in CI.
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
apps/mobile/ios/
apps/mobile/android/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# env & secrets — NEVER committed (RULES §11)
.env
.env.*
!.env.example

# supabase local
supabase/.branches/
supabase/.temp/

# agent scratch — never committed
.superpowers/

# local intermediates (e.g. the audio proof recordings) — regenerated on demand
.tmp/

# strip_mascot_bg.sh fallback venv (used only when uvx is unavailable)
scripts/.venv-mascot/

# OS / editor
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
